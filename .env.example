# Standalone API stack environment. Copy to .env (or run: bash docker/gen-env.sh,
# which generates these values idempotently) and fill in DEEPSEEK_API_KEY.
# .env is gitignored and chmod 600 — never commit real keys.

# Container runtime uid = host file owner uid (deployment red line A).
# gen-env.sh writes these automatically; only set them by hand if you know why.
HOST_UID=1000
HOST_GID=1000

# External HTTP port of the nginx front door (plain HTTP in v1; TLS not wired yet).
HTTP_PORT=80

# nginx image (override where nginx:alpine cannot be pulled, e.g. behind the GFW:
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:alpine, or a cached nginx:latest).
NGINX_IMAGE=nginx:alpine

# DSH host version baked into the image (verified pairings only — see README
# "Supported DSH versions"). Changing this requires a matching docker/profile-lock entry.
DSH_VERSION=0.2.0-rc.2

# Image build mirrors — set both when Docker Hub / npmjs are unreachable (China):
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
# NPM_REGISTRY=https://registry.npmmirror.com

# Static facade API key (X-API-Key for /api-gw/v1/*). Leave empty to use the one-time
# POST /api-gw/v1/key bootstrap instead — not recommended on a public surface.
GW_KEY=

# Model credentials — required for real session turns.
DEEPSEEK_API_KEY=

# Optional: OpenAI-compatible LLM route (the built-in pi-ai adapter). OPENAI_BASE_URL
# alone activates it. The variable vocabulary is SHARED with the sibling pi-api-facade
# project, so the same settings feed a Pi node and a DSH node alike. Every mounted
# route stays listed in session.models; per-session session.selectModel can switch.
# 0.2.x DSH lines only.
#   OPENAI_BASE_URL = the endpoint up to (not including) /chat/completions —
#                     usually ends in /v1 (e.g. https://api.openai.com/v1,
#                     https://api.deepseek.com/v1, http://ollama-host:11434/v1)
#   OPENAI_API_KEY  = optional — omit for key-less endpoints (Ollama). Never written
#                     to a config file: the profile references the env var by name.
#   OPENAI_PROVIDER = (openai) route key. The default overrides the endpoint of the
#                     built-in openai catalog route (its model ids come free); a custom
#                     id declares a brand-new route — then list its models explicitly.
#   OPENAI_MODELS   = comma-separated model ids (e.g. gpt-4o-mini,my-alias).
#                     NOTE: an explicit list REPLACES the route's catalog on the DSH
#                     side (the pi side adds to it) — practical effect is the same.
#   OPENAI_MODEL    = single-model shorthand, used when OPENAI_MODELS is absent.
#   FACADE_MODEL    = default model for new sessions, provider/model form
#                     (e.g. openai/gpt-4o-mini). Unset: first declared model, else the
#                     bundle default (deepseek-official/deepseek-flash) stays.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_PROVIDER=
# OPENAI_MODELS=
# OPENAI_MODEL=
# FACADE_MODEL=
# Optional refinements (defaults in parentheses):
# OPENAI_API=              (openai-completions) wire protocol; pi-ai also serves
#                          openai-responses / anthropic-messages / google-vertex
# OPENAI_CONTEXT_WINDOW=   (262144) route-level context fallback for undeclared models
# OPENAI_MAX_TOKENS=       (32768) route-level output fallback

# Optional facade knobs (defaults in parentheses):
# GW_ADMIN_KEY=            (unset: admin endpoints disabled)
# GW_ALLOW_FULL_ACCESS=    (false: sandbox route cannot grant danger-full-access)
# GW_EXPOSE_ERRORS=        (true: include internal error details in responses)
# GW_CORS_ORIGIN=          (*: CORS origin(s); tighten for public deployments)
