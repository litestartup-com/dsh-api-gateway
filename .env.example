# Standalone API stack environment. Copy to .env (or run: bash docker/gen-env.sh,
# which generates these values idempotently) and fill in DEEPSEEK_API_KEY.
# .env is gitignored and chmod 600 — never commit real keys.

# Container runtime uid = host file owner uid (deployment red line A).
# gen-env.sh writes these automatically; only set them by hand if you know why.
HOST_UID=1000
HOST_GID=1000

# External HTTP port of the nginx front door (plain HTTP in v1; TLS not wired yet).
HTTP_PORT=80

# nginx image (override where nginx:alpine cannot be pulled, e.g. behind the GFW:
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:alpine, or a cached nginx:latest).
NGINX_IMAGE=nginx:alpine

# DSH host version baked into the image (verified pairings only — see README
# "Supported DSH versions"). Changing this requires a matching docker/profile-lock entry.
DSH_VERSION=0.2.0-rc.2

# Image build mirrors — set both when Docker Hub / npmjs are unreachable (China):
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
# NPM_REGISTRY=https://registry.npmmirror.com

# Static facade API key (X-API-Key for /api-gw/v1/*). Leave empty to use the one-time
# POST /api-gw/v1/key bootstrap instead — not recommended on a public surface.
GW_KEY=

# Model credentials — required for real session turns.
DEEPSEEK_API_KEY=

# Optional: OpenAI-compatible LLM route (the built-in pi-ai adapter). Set ALL THREE
# to activate — the stack then declares the route and makes it the DEFAULT model for
# new sessions (the official DeepSeek route stays available alongside; per-session
# session.selectModel can switch). 0.2.x DSH lines only.
#   OPENAI_BASE_URL = the endpoint up to (not including) /chat/completions —
#                     usually ends in /v1 (e.g. https://api.openai.com/v1,
#                     https://api.deepseek.com/v1, or any compatible gateway)
#   OPENAI_API_KEY  = the key for that endpoint (env var name the node resolves)
#   OPENAI_MODEL    = a model id the endpoint serves (declared routes spell models out)
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Optional refinements (defaults in parentheses):
# OPENAI_ROUTE=                   (openai-compat) route key shown in session.models
# OPENAI_API=                     (openai-completions) wire protocol
# OPENAI_MODEL_NAME=              (model id) display name
# OPENAI_MODEL_CONTEXT_WINDOW=    (262144) context capacity claim
# OPENAI_MODEL_MAX_TOKENS=        (32768) output capability claim

# Optional facade knobs (defaults in parentheses):
# GW_ADMIN_KEY=            (unset: admin endpoints disabled)
# GW_ALLOW_FULL_ACCESS=    (false: sandbox route cannot grant danger-full-access)
# GW_EXPOSE_ERRORS=        (true: include internal error details in responses)
# GW_CORS_ORIGIN=          (*: CORS origin(s); tighten for public deployments)
