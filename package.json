{
  "name": "dsh-api-gateway",
  "version": "0.2.0",
  "description": "Open-source plugin for DeepSeek Harness: an authenticated, fail-closed loopback proxy that exposes the harness /api surface (apiproxy) to remote clients.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litestartup-com/dsh-api-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/litestartup-com/dsh-api-gateway/issues"
  },
  "homepage": "https://github.com/litestartup-com/dsh-api-gateway#readme",
  "author": "dsh-api-gateway contributors",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "openapi.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "prepack": "tsc -p tsconfig.json",
    "test": "node --test test/events.test.mjs test/http.test.mjs test/proxy.test.mjs",
    "proxy-host": "node scripts/proxy-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "api",
    "proxy",
    "apiproxy",
    "loopback"
  ]
}
